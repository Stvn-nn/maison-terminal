{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Maison Terminal",
  "version": "0.1.0",
  "identifier": "com.maisonterminal.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Maison Terminal",
        "width": 1360,
        "height": 860,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0D0D0E"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000 ws://127.0.0.1:8000 http://localhost:8000 ws://localhost:8000"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000 ws://127.0.0.1:8000 http://localhost:8000 ws://localhost:8000 http://localhost:1420 ws://localhost:1420"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Maison Terminal",
    "category": "Finance",
    "shortDescription": "Chart workspace for the Maison Terminal analytical service",
    "longDescription": "Maison Terminal is a Windows desktop workspace for the local Maison Terminal analytical service: chart indicators, macro catalysts, position sizing and screen-vision alerts.",
    "copyright": "Maison Terminal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
